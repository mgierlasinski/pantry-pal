# GET /recipes - Get recipes with default pagination (page=1, pageSize=20, sort=created_at)
GET {{PantryPal.Api_HostAddress}}/recipes

###

# GET /recipes - Get recipes with custom pagination
GET {{PantryPal.Api_HostAddress}}/recipes?page=1&pageSize=10&sort=created_at

###

# GET /recipes - Get recipes with custom page
GET {{PantryPal.Api_HostAddress}}/recipes?page=2&pageSize=5

###

# GET /recipes - Validation error: invalid page (less than 1)
GET {{PantryPal.Api_HostAddress}}/recipes?page=0&pageSize=10

###

# GET /recipes - Validation error: invalid pageSize (too large)
GET {{PantryPal.Api_HostAddress}}/recipes?page=1&pageSize=150

###

# GET /recipes - Validation error: invalid pageSize (too small)
GET {{PantryPal.Api_HostAddress}}/recipes?page=1&pageSize=0

###

# GET /recipes - Validation error: invalid sort parameter
GET {{PantryPal.Api_HostAddress}}/recipes?page=1&pageSize=10&sort=name

###

# POST /recipes/generate - Generate AI-powered recipe based on pantry items and preferences
POST {{PantryPal.Api_HostAddress}}/recipes/generate

###

# Note: Error scenarios for POST /recipes/generate
# 
# 400 Bad Request - "User preferences not set."
# This occurs when the user has not configured their dietary preferences.
# To test: ensure the test user has no preferences in the user_preferences table.
#
# 400 Bad Request - "Pantry is empty."
# This occurs when the user has no pantry items.
# To test: ensure the test user has no items in the pantry_items table.
#
# 500 Internal Server Error - "Failed to generate recipe. Please try again later."
# This occurs when the AI service fails to generate a recipe.
# To test: modify the MockAIRecipeGeneratorService to throw an exception.

###

# POST /recipes/{generationId}/accept - Accept a generated recipe and save it to recipes table
# Note: Replace @ExistingGenerationId with a valid generation ID from POST /recipes/generate response
POST {{PantryPal.Api_HostAddress}}/recipes/{{ExistingGenerationId}}/accept

###

# POST /recipes/{generationId}/accept - Error: generation not found
POST {{PantryPal.Api_HostAddress}}/recipes/00000000-0000-0000-0000-999999999999/accept

###

# POST /recipes/{generationId}/accept - Error: already accepted (409 Conflict)
# Note: This will fail if trying to accept the same generation twice
# To test: run the same accept request twice with the same valid generation ID

###

# Note: Error scenarios for POST /recipes/{generationId}/accept
#
# 404 Not Found - "Generation not found"
# This occurs when the generation ID doesn't exist or doesn't belong to the user.
#
# 409 Conflict - "Already accepted"
# This occurs when attempting to accept a generation that has already been accepted.
#
# 400 Bad Request - "No recipe text available"
# This occurs when the generation record exists but has no recipe text (error during generation).
#
# 201 Created - Success
# Returns the new recipe ID and timestamp when successfully accepted.

###
