@PantryPal.Api_HostAddress = https://localhost:7154
@ExistingPantryItem = 7b2e7457-8a9d-4cc4-807c-f7c2489008b5

# GET /pantry-items - Get pantry items with default pagination (page=1, pageSize=20, sort=created_at)
GET {{PantryPal.Api_HostAddress}}/pantry-items

###

# GET /pantry-items - Get pantry items with custom pagination
GET {{PantryPal.Api_HostAddress}}/pantry-items?page=1&pageSize=10&sort=created_at

###

# GET /pantry-items - Get pantry items with custom page and name sorting
GET {{PantryPal.Api_HostAddress}}/pantry-items?page=2&pageSize=5&sort=name

###

# GET /pantry-items - Validation error: invalid page (less than 1)
GET {{PantryPal.Api_HostAddress}}/pantry-items?page=0&pageSize=10

###

# GET /pantry-items - Validation error: invalid pageSize (too large)
GET {{PantryPal.Api_HostAddress}}/pantry-items?page=1&pageSize=150

###

# GET /pantry-items - Validation error: invalid pageSize (too small)
GET {{PantryPal.Api_HostAddress}}/pantry-items?page=1&pageSize=0

###

# GET /pantry-items - Validation error: invalid sort parameter
GET {{PantryPal.Api_HostAddress}}/pantry-items?page=1&pageSize=10&sort=invalid

###

# POST /pantry-items - Create pantry item
POST {{PantryPal.Api_HostAddress}}/pantry-items
Content-Type: application/json

{
  "name": "Tomato"
}

###

# POST /pantry-items - Validation error: empty name
POST {{PantryPal.Api_HostAddress}}/pantry-items
Content-Type: application/json

{
  "name": ""
}

###

# POST /pantry-items - Validation error: name too long
POST {{PantryPal.Api_HostAddress}}/pantry-items
Content-Type: application/json

{
  "name": "A very long name that exceeds the maximum allowed length of 100 characters for pantry item names which should trigger validation error"
}

###

# PATCH /pantry-items/{id} - Update pantry item name
PATCH {{PantryPal.Api_HostAddress}}/pantry-items/{{ExistingPantryItem}}
Content-Type: application/json

{
  "name": "Cherry Tomato"
}

###

# PATCH /pantry-items/{id} - Update pantry item favorite status
PATCH {{PantryPal.Api_HostAddress}}/pantry-items/{{ExistingPantryItem}}
Content-Type: application/json

{
  "isFavorite": true
}

###

# PATCH /pantry-items/{id} - Update both name and favorite status
PATCH {{PantryPal.Api_HostAddress}}/pantry-items/{{ExistingPantryItem}}
Content-Type: application/json

{
  "name": "Organic Cherry Tomato",
  "isFavorite": true
}

###

# PATCH /pantry-items/{id} - Validation error: no fields provided
PATCH {{PantryPal.Api_HostAddress}}/pantry-items/{{ExistingPantryItem}}
Content-Type: application/json

{
}

###

# PATCH /pantry-items/{id} - Validation error: empty name
PATCH {{PantryPal.Api_HostAddress}}/pantry-items/{{ExistingPantryItem}}
Content-Type: application/json

{
  "name": ""
}

###

# PATCH /pantry-items/{id} - Validation error: name too long
PATCH {{PantryPal.Api_HostAddress}}/pantry-items/{{ExistingPantryItem}}
Content-Type: application/json

{
  "name": "A very long name that exceeds the maximum allowed length of 100 characters for pantry item names which should trigger validation error"
}

###

# PATCH /pantry-items/{id} - Error: item not found
PATCH {{PantryPal.Api_HostAddress}}/pantry-items/00000000-0000-0000-0000-999999999999
Content-Type: application/json

{
  "name": "Non-existent Item"
}

