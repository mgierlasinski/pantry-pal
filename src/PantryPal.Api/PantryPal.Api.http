# GET /user-preferences - Get user preferences (requires authentication)
# Note: Authentication not yet fully implemented in http file
# TODO: Add Authorization header with Supabase JWT when authentication is enabled
GET {{PantryPal.Api_HostAddress}}/user-preferences

###

# Note: Response scenarios for GET /user-preferences
#
# 200 OK - Success
# Returns UserPreferencesDto with resolved diet type and cuisine names.
# Example response:
# {
#   "userId": "uuid-string",
#   "dietTypeId": 1,
#   "dietTypeName": "vegetarian",
#   "preferredCuisineId": 1,
#   "preferredCuisineName": "Italian",
#   "dislikedIngredients": "nuts, shellfish",
#   "createdAt": "2025-10-29T10:00:00Z",
#   "updatedAt": "2025-10-29T10:00:00Z"
# }
#
# 401 Unauthorized - "Authentication required"
# This occurs when no valid JWT token is provided or user is not authenticated.
#
# 404 Not Found - "User preferences not found"
# This occurs when the authenticated user has not set their preferences yet.
#
# 500 Internal Server Error - Unexpected errors
# This occurs for database or other server-side errors.

###

# POST /user-preferences - Create or update user preferences (upsert)
# Note: Authentication not yet fully implemented in http file
# TODO: Add Authorization header with Supabase JWT when authentication is enabled
POST {{PantryPal.Api_HostAddress}}/user-preferences
Content-Type: application/json

{
  "dietTypeId": 1,
  "preferredCuisineId": 1,
  "dislikedIngredients": "nuts, shellfish"
}

