# DELETE /pantry-items/{id} - Delete existing pantry item
DELETE {{PantryPal.Api_HostAddress}}/pantry-items/20064eb6-236c-4eec-90f9-3db822d659be

###

# DELETE /pantry-items/{id} - Error: item not found
DELETE {{PantryPal.Api_HostAddress}}/pantry-items/00000000-0000-0000-0000-999999999999

