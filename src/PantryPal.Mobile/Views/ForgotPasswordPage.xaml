<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PantryPal.Mobile.ViewModels"
             xmlns:converters="clr-namespace:PantryPal.Mobile.Converters"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:const="clr-namespace:PantryPal.Mobile.Constants"
             xmlns:m="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:v="clr-namespace:UraniumUI.Validations;assembly=UraniumUI.Validations.DataAnnotations"
             xmlns:controls="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
             x:Class="PantryPal.Mobile.Views.ForgotPasswordPage"
             x:DataType="viewModels:ForgotPasswordPageViewModel"
             Title="Reset Password">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <!-- App Title/Logo Area -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                <Label Text="🍳 PantryPal"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource Primary}" />
                <Label Text="Reset your password"
                       FontSize="18"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource Gray600}" />
            </VerticalStackLayout>

            <!-- Instructions -->
            <Label Text="Enter your email address and we'll send you a link to reset your password."
                   FontSize="14"
                   TextColor="{DynamicResource Gray600}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,16,0,0" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="{DynamicResource Primary}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Margin="0,20,0,0"
                             WidthRequest="48"
                             HeightRequest="48" />

            <controls:FormView SubmitCommand="{Binding SendResetEmailCommand}">
                <VerticalStackLayout Margin="0,16,0,0" Spacing="15">
                    <!-- Email Field -->
                    <material:TextField
                        Text="{Binding Email}"
                        Icon="{FontImageSource FontFamily={x:Static const:MaterialFont.Outlined}, Glyph={x:Static m:MaterialOutlined.Mail}}"
                        Title="Email"
                        Keyboard="Email"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        ReturnType="Send">
                        <material:TextField.Behaviors>
                            <v:DataAnnotationsBehavior Binding="{Binding Email}" />
                        </material:TextField.Behaviors>
                    </material:TextField>

                    <!-- Send Reset Link Button -->
                    <Button Text="Send Reset Link"
                            controls:FormView.IsSubmitButton="True"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="56"
                            CornerRadius="12"
                            Margin="0,16,0,0"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </controls:FormView>

            <!-- Navigation Links -->
            <VerticalStackLayout Spacing="8" Margin="0,16,0,0">
                <Button Text="Back to Sign In"
                        Command="{Binding NavigateToLoginCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Primary}"
                        FontSize="14"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
