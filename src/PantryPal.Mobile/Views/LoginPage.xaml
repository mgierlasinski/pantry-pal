<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PantryPal.Mobile.ViewModels"
             xmlns:converters="clr-namespace:PantryPal.Mobile.Converters"
             x:Class="PantryPal.Mobile.Views.LoginPage"
             x:DataType="viewModels:LoginPageViewModel"
             Title="Login">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <!-- App Title/Logo Area -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                <Label Text="🍳 PantryPal"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource Primary}" />
                <Label Text="Welcome back!"
                       FontSize="18"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource Gray600}" />
            </VerticalStackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="{DynamicResource Primary}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Margin="0,20,0,0"
                             WidthRequest="48"
                             HeightRequest="48"
                             AutomationId="LoadingIndicator" />

            <!-- Email Field -->
            <VerticalStackLayout Margin="0,16,0,0" Spacing="4">
                <Label Text="Email" FontSize="16" FontAttributes="Bold" />
                <Entry Text="{Binding Email}"
                       Placeholder="Enter your email"
                       Keyboard="Email"
                       IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                       ReturnType="Next"
                       AutomationId="EmailEntry" />
            </VerticalStackLayout>

            <!-- Password Field -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Password" FontSize="16" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="0">
                    <Entry Text="{Binding Password}"
                           Placeholder="Enter your password"
                           IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}}"
                           IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                           ReturnType="Done"
                           HorizontalOptions="FillAndExpand"
                           AutomationId="PasswordEntry" />
                    <Button Text="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}, ConverterParameter='Hide:Show'}"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Gray600}"
                            FontSize="14"
                            WidthRequest="60"
                            Padding="8,0"
                            AutomationId="TogglePasswordButton" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Login Button -->
            <Button Text="Log In"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="{DynamicResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="12"
                    Margin="0,16,0,0"
                    HorizontalOptions="Fill"
                    AutomationId="LoginButton" />

            <!-- Navigation Links -->
            <VerticalStackLayout Spacing="8" Margin="0,16,0,0">
                <Button Text="Don't have an account? Sign Up"
                        Command="{Binding NavigateToRegisterCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Primary}"
                        FontSize="14"
                        HorizontalOptions="Center"
                        AutomationId="SignUpButton" />

                <Button Text="Forgot your password?"
                        Command="{Binding NavigateToForgotPasswordCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Gray600}"
                        FontSize="14"
                        HorizontalOptions="Center"
                        AutomationId="ForgotPasswordButton" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
