<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PantryPal.Mobile.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
    xmlns:converters="clr-namespace:PantryPal.Mobile.Converters"
    xmlns:data="clr-namespace:PantryPal.Data;assembly=PantryPal.Data"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:v="clr-namespace:UraniumUI.Validations;assembly=UraniumUI.Validations.DataAnnotations"
    xmlns:viewModels="clr-namespace:PantryPal.Mobile.ViewModels"
    Title="Profile Settings"
    x:DataType="viewModels:ProfileViewModel">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <Grid
        Padding="20"
        RowDefinitions="*,Auto"
        VerticalOptions="Fill">

        <!--  Loading Indicator  -->
        <ActivityIndicator
            Margin="0,60,0,20"
            AutomationId="ProfileLoadingIndicator"
            HeightRequest="48"
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Start"
            WidthRequest="48"
            Color="{DynamicResource Primary}" />

        <controls:FormView
            Spacing="20"
            SubmitCommand="{Binding SavePreferencesCommand}"
            VerticalOptions="Fill">
            <!--  Diet Type Picker  -->
            <material:PickerField
                Title="Diet Type"
                AllowClear="False"
                AutomationId="DietTypePicker"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                ItemDisplayBinding="{Binding Name, x:DataType=data:DietTypeDto}"
                ItemsSource="{Binding DietTypes}"
                SelectedItem="{Binding SelectedDietType}">
                <material:PickerField.Behaviors>
                    <v:DataAnnotationsBehavior Binding="{Binding SelectedDietType}" />
                </material:PickerField.Behaviors>
            </material:PickerField>
            <!--  Preferred Cuisine Picker  -->
            <material:PickerField
                Title="Preferred Cuisine"
                AllowClear="False"
                AutomationId="PreferredCuisinePicker"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                ItemDisplayBinding="{Binding Name, x:DataType=data:PreferredCuisineDto}"
                ItemsSource="{Binding PreferredCuisines}"
                SelectedItem="{Binding SelectedPreferredCuisine}">
                <material:PickerField.Behaviors>
                    <v:DataAnnotationsBehavior Binding="{Binding SelectedPreferredCuisine}" />
                </material:PickerField.Behaviors>
            </material:PickerField>
            <!--  Disliked Ingredients Editor  -->
            <material:EditorField
                Title="List any ingredients you dislike (optional)"
                AutomationId="DislikedIngredientsEditor"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                Text="{Binding DislikedIngredients}">
                <material:EditorField.Behaviors>
                    <v:DataAnnotationsBehavior Binding="{Binding DislikedIngredients}" />
                </material:EditorField.Behaviors>
            </material:EditorField>
            <!--  Save Button  -->
            <Button
                Margin="0,8,0,0"
                controls:FormView.IsSubmitButton="True"
                AutomationId="SavePreferencesButton"
                HorizontalOptions="Fill"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                Style="{StaticResource PrimaryButton}"
                Text="Save Preferences" />
        </controls:FormView>

        <!--  Logout Button  -->
        <Button
            Grid.Row="1"
            AutomationId="LogoutButton"
            Command="{Binding LogoutCommand}"
            HorizontalOptions="Fill"
            Style="{StaticResource SecondaryButton}"
            Text="Logout" />
    </Grid>

</ContentPage>
