<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PantryPal.Mobile.ViewModels"
             xmlns:converters="clr-namespace:PantryPal.Mobile.Converters"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:const="clr-namespace:PantryPal.Mobile.Constants"
             xmlns:m="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:v="clr-namespace:UraniumUI.Validations;assembly=UraniumUI.Validations.DataAnnotations"
             xmlns:controls="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
             x:Class="PantryPal.Mobile.Views.RegisterPage"
             x:DataType="viewModels:RegisterPageViewModel"
             Title="Register">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <!-- App Title/Logo Area -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                <Label Text="🍳 PantryPal"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource Primary}" />
                <Label Text="Create your account"
                       FontSize="18"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource Gray600}" />
            </VerticalStackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="{DynamicResource Primary}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Margin="0,20,0,0"
                             WidthRequest="48"
                             HeightRequest="48" />

            <controls:FormView SubmitCommand="{Binding RegisterCommand}">
                <VerticalStackLayout Margin="0,16,0,0" Spacing="15">
                    <!-- Email Field -->
                    <material:TextField
                        Text="{Binding Email}"
                        Icon="{FontImageSource FontFamily={x:Static const:MaterialFont.Outlined}, Glyph={x:Static m:MaterialOutlined.Mail}}"
                        Title="Email"
                        Keyboard="Email"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        ReturnType="Next">
                        <material:TextField.Behaviors>
                            <v:DataAnnotationsBehavior Binding="{Binding Email}" />
                        </material:TextField.Behaviors>
                    </material:TextField>

                    <!-- Password Field -->
                    <material:TextField
                        Text="{Binding Password}"
                        Icon="{FontImageSource FontFamily={x:Static const:MaterialFont.Outlined}, Glyph={x:Static m:MaterialOutlined.Lock}}"
                        Title="Password"
                        IsPassword="True"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        ReturnType="Next">
                        <material:TextField.Attachments>
                            <material:TextFieldPasswordShowHideAttachment />
                        </material:TextField.Attachments>
                        <material:TextField.Behaviors>
                            <v:DataAnnotationsBehavior Binding="{Binding Password}" />
                        </material:TextField.Behaviors>
                    </material:TextField>

                    <!-- Confirm Password Field -->
                    <material:TextField
                        Text="{Binding ConfirmPassword}"
                        Icon="{FontImageSource FontFamily={x:Static const:MaterialFont.Outlined}, Glyph={x:Static m:MaterialOutlined.Lock}}"
                        Title="Confirm Password"
                        IsPassword="True"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        ReturnType="Done">
                        <material:TextField.Attachments>
                            <material:TextFieldPasswordShowHideAttachment />
                        </material:TextField.Attachments>
                        <material:TextField.Behaviors>
                            <v:DataAnnotationsBehavior Binding="{Binding ConfirmPassword}" />
                        </material:TextField.Behaviors>
                    </material:TextField>

                    <!-- Register Button -->
                    <Button Text="Sign Up"
                            Style="{StaticResource PrimaryButton}"
                            StyleClass="FilledButton"
                            controls:FormView.IsSubmitButton="True"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Margin="0,16,0,0"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </controls:FormView>

            <!-- Navigation Links -->
            <VerticalStackLayout Spacing="8" Margin="0,16,0,0">
                <Button Text="Already have an account? Sign In"
                        Command="{Binding NavigateToLoginCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Primary}"
                        FontSize="14"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
